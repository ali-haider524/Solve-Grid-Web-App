# Canonical production domain. Keep this exact domain unless you intentionally
# change every canonical URL, sitemap entry, redirect, and Search Console property.
SITE_URL=https://solvegrid.online

# Add this only after Search Console gives you a real verification token.
GOOGLE_SITE_VERIFICATION=

# Create this mailbox before publishing it. Leave blank until it works.
# Example: support@solvegrid.online
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional legal operator or business name shown in policy/support updates.
NEXT_PUBLIC_SITE_OPERATOR=SolveGrid

# Optional public profiles. Add only real profiles that you control.
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# SEO monitoring agent (server/CI only; never expose these as NEXT_PUBLIC_* variables).
# Use ONE of GOOGLE_SERVICE_ACCOUNT_FILE / GOOGLE_SERVICE_ACCOUNT_JSON /
# GOOGLE_SERVICE_ACCOUNT_B64. GitHub Actions uses the base64 form.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_B64=

# Numeric GA4 property ID, e.g. 123456789. This is NOT the G- measurement ID.
GA4_PROPERTY_ID=

# Optional. Recommended for scheduled PageSpeed usage.
PAGESPEED_API_KEY=

# Local overrides. GitHub controls these automatically.
SEO_INDEXING_ENABLED=true
PAGESPEED_ENABLED=false
